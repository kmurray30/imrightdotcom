{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "imright-user-submissions"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "builtIn": true,
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "query": {
            "datasource": {
              "name": "-- Grafana --"
            },
            "group": "grafana",
            "kind": "DataQuery",
            "spec": {},
            "version": "v0"
          }
        }
      }
    ],
    "cursorSync": "Crosshair",
    "editable": true,
    "links": [],
    "liveNow": false,
    "preload": false,
    "tags": [
      "imright"
    ],
    "title": "User Submissions",
    "variables": [],
    "timeSettings": {
      "autoRefresh": "1m",
      "autoRefreshIntervals": [
        "5s",
        "10s",
        "30s",
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "2h",
        "1d"
      ],
      "fiscalYearStartMonth": 0,
      "from": "now-24h",
      "hideTimepicker": false,
      "timezone": "browser",
      "to": "now"
    },
    "preferences": {
      "layout": {
        "kind": "GridLayout",
        "spec": {
          "items": []
        }
      }
    },
    "elements": {
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Claims logged (selected range)",
          "description": "Coverage caveat: only counts claims that landed in a traced interaction — every error/anomaly, plus a rolling sample that tapers down as traffic grows (100% under ~20 interactions/hour, down to 1% at high volume — see verbosityTiers in config/telemetry_thresholds.json). Very likely 100% at today's traffic; not a guaranteed-complete count once volume grows.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "grafanacloud-logs"
                      },
                      "spec": {
                        "expr": "count_over_time({service_name=\"imright\"} |= `interaction_trace` [$__range])",
                        "queryType": "instant"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "version": "13.3.0-34259522365",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "decimals": 0
                },
                "overrides": []
              },
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "textMode": "auto",
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto"
              }
            }
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Submitted claims",
          "description": "Newest first, claim text only. Click a row to expand the full trace (visitor_id, interaction_id, tags, per-step timings) — that detail is deliberately hidden by default, not shown inline.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "grafanacloud-logs"
                      },
                      "spec": {
                        "expr": "{service_name=\"imright\"} |= `interaction_trace` | json claim_text | line_format \"{{.claim_text}}\"",
                        "queryType": "range"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "group": "logs",
            "kind": "VizConfig",
            "version": "13.3.0-34259522365",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              },
              "options": {
                "showTime": true,
                "wrapLogMessage": true,
                "sortOrder": "Descending",
                "enableLogDetails": true
              }
            }
          }
        }
      }
    },
    "layout": {
      "kind": "GridLayout",
      "spec": {
        "items": [
          {
            "kind": "GridLayoutItem",
            "spec": {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 3,
              "element": {
                "kind": "ElementReference",
                "name": "panel-2"
              }
            }
          },
          {
            "kind": "GridLayoutItem",
            "spec": {
              "x": 0,
              "y": 3,
              "width": 24,
              "height": 25,
              "element": {
                "kind": "ElementReference",
                "name": "panel-3"
              }
            }
          }
        ]
      }
    }
  }
}
