{
  "__inputs": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus (Grafana Cloud Metrics)", "description": "", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus" }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" }
  ],
  "title": "imright — Pipeline & External APIs",
  "uid": "imright-pipeline-external",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "1m",
  "tags": ["imright"],
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    { "id": 1, "type": "timeseries", "title": "External calls by service and status",
      "description": "service = mediawiki | pixabay | link_checker. status = success | timeout | rate_limited | server_error | client_error | network_error.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (service, status) (rate(imright_external_calls_total[$__rate_interval]))", "legendFormat": "{{service}} / {{status}}" } ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } } },

    { "id": 2, "type": "timeseries", "title": "External call latency p95 by service",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "histogram_quantile(0.95, sum by (le, service) (rate(imright_external_latency_ms_bucket[$__rate_interval])))", "legendFormat": "{{service}}" } ],
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 2, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } } },

    { "id": 3, "type": "timeseries", "title": "429 / rate-limited responses",
      "description": "Only populated for services that go through the shared retry wrapper with 429 detection (MediaWiki, Pixabay) — link_checker hits arbitrary third-party hosts and isn't a single rate-limited dependency.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (service, operation) (increase(imright_external_rate_limited_total[$__rate_interval]))", "legendFormat": "{{service}} / {{operation}}" } ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal", "group": "A" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } } },

    { "id": 4, "type": "stat", "title": "MediaWiki failure rate",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(imright_external_calls_total{service=\"mediawiki\",status!=\"success\"}[$__rate_interval])) / sum(rate(imright_external_calls_total{service=\"mediawiki\"}[$__rate_interval]))", "instant": true } ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1, "min": 0, "max": 1,
        "thresholds": { "mode": "absolute", "steps": [ { "value": null, "color": "green" }, { "value": 0.05, "color": "orange" }, { "value": 0.2, "color": "red" } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto" } },

    { "id": 5, "type": "stat", "title": "Pixabay failure rate",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(imright_external_calls_total{service=\"pixabay\",status!=\"success\"}[$__rate_interval])) / sum(rate(imright_external_calls_total{service=\"pixabay\"}[$__rate_interval]))", "instant": true } ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1, "min": 0, "max": 1,
        "thresholds": { "mode": "absolute", "steps": [ { "value": null, "color": "green" }, { "value": 0.05, "color": "orange" }, { "value": 0.2, "color": "red" } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto" } },

    { "id": 6, "type": "stat", "title": "Link-checker failure rate",
      "description": "\"Failure\" here includes dead links found (404/403/timeout) — expected to be nonzero regularly, this is a content-quality signal, not a health alarm.",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(imright_external_calls_total{service=\"link_checker\",status!=\"success\"}[$__rate_interval])) / sum(rate(imright_external_calls_total{service=\"link_checker\"}[$__rate_interval]))", "instant": true } ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1, "min": 0, "max": 1 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto" } },

    { "id": 7, "type": "stat", "title": "MediaWiki rate-limited (selected range)",
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(increase(imright_external_rate_limited_total{service=\"mediawiki\"}[$__range]))", "instant": true } ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0,
        "thresholds": { "mode": "absolute", "steps": [ { "value": null, "color": "green" }, { "value": 1, "color": "orange" }, { "value": 10, "color": "red" } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto" } },

    { "id": 8, "type": "stat", "title": "Pixabay rate-limited (selected range)",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(increase(imright_external_rate_limited_total{service=\"pixabay\"}[$__range]))", "instant": true } ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0,
        "thresholds": { "mode": "absolute", "steps": [ { "value": null, "color": "green" }, { "value": 1, "color": "orange" }, { "value": 10, "color": "red" } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto" } },

    { "id": 9, "type": "timeseries", "title": "External retries by pipeline step and reason",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (pipeline_step, reason) (increase(imright_retries_total{kind=\"external\"}[$__rate_interval]))", "legendFormat": "{{pipeline_step}} / {{reason}}" } ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal", "group": "A" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } } },

    { "id": 10, "type": "timeseries", "title": "Link-checker outcomes over time",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (status) (rate(imright_external_calls_total{service=\"link_checker\"}[$__rate_interval]))", "legendFormat": "{{status}}" } ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } } }
  ]
}
