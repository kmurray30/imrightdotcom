      "panel-12": {
        "kind": "Panel",
        "spec": {
          "id": 12,
          "title": "Rate-limited interactions (any external dependency)",
          "description": "Uses a plain text match on the tags list rather than a `| json` field filter — tags is a JSON array, and Loki's structured-metadata/json array handling is inconsistent enough that a substring match on the raw JSON body (guaranteed present, see logStructured()) is the more reliable pattern here.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
