      "panel-15": {
        "kind": "Panel",
        "spec": {
          "id": 15,
          "title": "Trace a specific interaction (edit the query below with a real interaction_id)",
          "description": "Dropped the dashboard-variable version of this panel — this instance's Grafana schema doesn't (yet) accept a TextVariable kind, and rather than guess at another unverified name, this is a template: copy an interaction_id from any panel above, paste it over REPLACE_WITH_INTERACTION_ID in the query, and run it. Pulls the full step-by-step trace, if one was captured (sampled, error, or anomaly-tagged — see verbosityTiers in config/telemetry_thresholds.json).",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
