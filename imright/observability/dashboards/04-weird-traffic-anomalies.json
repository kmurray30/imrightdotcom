            "version": "13.3.0-34259522365",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              },
              "options": {
                "mode": "markdown",
                "content": "### Bookmarked investigative queries\nGrafana has no importable \"saved search\" object, so each panel below is a ready-made LogQL query against `interaction_summary`/`interaction_trace` logs — open this dashboard instead of retyping a query in Explore. Each queries `{service_name=\"imright\"}` and parses the JSON body (`| json`) that `logStructured()` writes for every interaction."
              }
            }
          }
        }
      },
      "panel-8": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "Failed interactions",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "grafanacloud-logs"
                      },
                      "spec": {
                        "expr": "{service_name=\"imright\"} |= `interaction_summary` | json | success=`false`",
                        "queryType": "range"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "group": "logs",
            "kind": "VizConfig",
            "version": "13.3.0-34259522365",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              },
              "options": {
                "showTime": true,
                "wrapLogMessage": true,
                "sortOrder": "Descending",
                "enableLogDetails": true
              }
            }
          }
        }
      },
