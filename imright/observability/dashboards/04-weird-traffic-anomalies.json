{
  "__inputs": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus (Grafana Cloud Metrics)", "description": "", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus" },
    { "name": "DS_LOKI", "label": "Loki (Grafana Cloud Logs)", "description": "", "type": "datasource", "pluginId": "loki", "pluginName": "Loki" }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "bargauge", "name": "Bar gauge", "version": "" },
    { "type": "panel", "id": "logs", "name": "Logs", "version": "" },
    { "type": "panel", "id": "text", "name": "Text", "version": "" }
  ],
  "title": "imright — Weird Traffic & Anomalies",
  "uid": "imright-weird-anomalies",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "1m",
  "tags": ["imright"],
  "templating": { "list": [
    { "name": "interaction_id", "type": "textbox", "label": "Interaction ID (for the trace panel below)", "query": "", "current": { "text": "", "value": "" }, "hide": 0 }
  ] },
  "annotations": { "list": [] },
  "panels": [
    { "id": 1, "type": "timeseries", "title": "Anomaly tags over time",
      "description": "failed, high_cost, high_token, excessive_llm_calls, retry_heavy, large_input, large_output, rate_limited, mediawiki_rate_limited, image_search_rate_limited, suspected_abuse, duplicate_request. An interaction can carry several.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (tag) (increase(imright_interaction_tags_total[$__rate_interval]))", "legendFormat": "{{tag}}" } ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal", "group": "A" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } } },

    { "id": 2, "type": "bargauge", "title": "Anomaly tag share (selected range)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (tag) (increase(imright_interaction_tags_total[$__range]))", "legendFormat": "{{tag}}", "instant": true } ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } } },

    { "id": 3, "type": "stat", "title": "Suspicious API traffic (selected range)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(increase(imright_http_requests_total{traffic_class=\"suspicious_api\"}[$__range]))", "instant": true } ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "red" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto" } },

    { "id": 4, "type": "stat", "title": "Scanner probe traffic (selected range)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(increase(imright_http_requests_total{traffic_class=\"scanner_probe\"}[$__range]))", "instant": true } ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "yellow" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto" } },

    { "id": 5, "type": "stat", "title": "% of /api/run traffic that's suspicious",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(increase(imright_http_requests_total{traffic_class=\"suspicious_api\"}[$__range])) / sum(increase(imright_http_requests_total{traffic_class=~\"api_run|suspicious_api\"}[$__range]))", "instant": true } ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1, "min": 0, "max": 1,
        "thresholds": { "mode": "absolute", "steps": [ { "value": null, "color": "green" }, { "value": 0.05, "color": "orange" }, { "value": 0.2, "color": "red" } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto" } },

    { "id": 6, "type": "stat", "title": "% of all traffic that's scanner noise",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(increase(imright_http_requests_total{traffic_class=\"scanner_probe\"}[$__range])) / sum(increase(imright_http_requests_total[$__range]))", "instant": true } ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1, "min": 0, "max": 1 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto" } },

    { "id": 7, "type": "text", "title": "",
      "gridPos": { "h": 2, "w": 24, "x": 0, "y": 16 },
      "options": { "mode": "markdown", "content": "### Bookmarked investigative queries\nGrafana has no importable \"saved search\" object, so each panel below is a ready-made LogQL query against `interaction_summary`/`interaction_trace` logs — open this dashboard instead of retyping a query in Explore. Each queries `{service_name=\"imright\"}` and parses the JSON body (`| json`) that `logStructured()` writes for every interaction." } },

    { "id": 8, "type": "logs", "title": "Failed interactions",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "expr": "{service_name=\"imright\"} |= `interaction_summary` | json | success=`false`" } ],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true } },

    { "id": 9, "type": "logs", "title": "High-cost interactions (> $0.05)",
      "description": "Change the threshold in the query to match config/telemetry_thresholds.json's highCostUsd, or whatever you're curious about.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 26 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "expr": "{service_name=\"imright\"} |= `interaction_summary` | json | cost_usd > 0.05" } ],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true } },

    { "id": 10, "type": "logs", "title": "Interactions with more than 8 LLM calls",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 34 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "expr": "{service_name=\"imright\"} |= `interaction_summary` | json | llm_calls > 8" } ],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true } },

    { "id": 11, "type": "logs", "title": "Retry-heavy interactions (3+ LLM retries)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 42 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "expr": "{service_name=\"imright\"} |= `interaction_summary` | json | llm_retries >= 3" } ],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true } },

    { "id": 12, "type": "logs", "title": "Rate-limited interactions (any external dependency)",
      "description": "Uses a plain text match on the tags list rather than a `| json` field filter — tags is a JSON array, and Loki's structured-metadata/json array handling is inconsistent enough that a substring match on the raw JSON body (guaranteed present, see logStructured()) is the more reliable pattern here.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 50 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "expr": "{service_name=\"imright\"} |= `interaction_summary` |= `rate_limited`" } ],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true } },

    { "id": 13, "type": "logs", "title": "Suspected abuse",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 58 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "expr": "{service_name=\"imright\"} |= `interaction_summary` |= `suspected_abuse`" } ],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true } },

    { "id": 14, "type": "logs", "title": "Duplicate/repeated requests",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 66 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "expr": "{service_name=\"imright\"} |= `interaction_summary` |= `duplicate_request`" } ],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true } },

    { "id": 15, "type": "logs", "title": "Trace a specific interaction (fill in the Interaction ID variable above)",
      "description": "Set the interaction_id dashboard variable to an interaction_id from any panel above to pull its full step-by-step trace, if one was captured (sampled, error, or anomaly-tagged — see verbosityTiers in config/telemetry_thresholds.json).",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 74 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "expr": "{service_name=\"imright\"} |= \"$interaction_id\"" } ],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Ascending", "enableLogDetails": true } }
  ]
}
