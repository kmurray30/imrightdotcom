            "spec": {
              "fieldConfig": {
                "defaults": {
                  "unit": "percentunit",
                  "decimals": 1,
                  "min": 0,
                  "max": 1,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 0.05,
                        "color": "orange"
