      "panel-14": {
        "kind": "Panel",
        "spec": {
          "id": 14,
          "title": "CLIP embedding latency p95 by kind",
          "description": "query = embedding the rich description on the request path (blocking — needed before deciding what image to show). image = embedding a newly downloaded image, deferred until after page-ready (imright/index.js), runs concurrently with the counterarguments LLM call. A cold first-ever call also pays model-load time, so an early one-off spike here is expected, not a regression.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": { "name": "grafanacloud-prom" },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(imright_image_cache_embedding_latency_ms_bucket[$__rate_interval])))",
                        "instant": false,
                        "range": true,
                        "legendFormat": "{{kind}}"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "version": "13.3.0-34259522365",
            "spec": {
              "fieldConfig": {
                "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 5, "lineWidth": 1, "showPoints": "never" } },
                "overrides": []
              },
              "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
            }
          }
        }
      },
      "panel-15": {
        "kind": "Panel",
        "spec": {
          "id": 15,
          "title": "Embedding search misses (rate)",
          "description": "Rate of embedding-index misses — a rich description scored below threshold against everything in the local corpus, and fell back to a live Pixabay search. High and flat over a long period for the same handful of concepts is the \"chronically weak Pixabay result\" edge case discussed when this was designed — worth spot-checking which queries those are (via the interaction_trace logs) rather than just watching the number.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": { "name": "grafanacloud-prom" },
                      "spec": {
