                        "exemplar": false,
                        "expr": "sum(rate(imright_image_cache_lookups_total{tier=\"embedding\",result=\"miss\"}[$__rate_interval]))",
                        "instant": false,
                        "range": true,
                        "legendFormat": "embedding misses/sec"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "version": "13.3.0-34259522365",
            "spec": {
              "fieldConfig": {
                "defaults": { "unit": "reqps", "min": 0, "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 1, "showPoints": "never" } },
                "overrides": []
              },
              "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } }
            }
          }
