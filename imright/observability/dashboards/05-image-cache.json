{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "imright-image-cache"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "builtIn": true,
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "query": {
            "datasource": { "name": "-- Grafana --" },
            "group": "grafana",
            "kind": "DataQuery",
            "spec": {},
            "version": "v0"
          }
        }
      }
    ],
    "cursorSync": "Crosshair",
    "editable": true,
    "links": [],
    "liveNow": false,
    "preload": false,
    "tags": ["imright"],
    "title": "Pixabay Image Cache",
    "variables": [],
    "timeSettings": {
      "autoRefresh": "1m",
      "autoRefreshIntervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"],
      "fiscalYearStartMonth": 0,
      "from": "now-24h",
      "hideTimepicker": false,
      "timezone": "browser",
      "to": "now"
    },
    "preferences": { "layout": { "kind": "GridLayout", "spec": { "items": [] } } },
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Hit rate % by tier",
          "description": "embedding = stage 0 (did a rich description score close enough to a stored image's own CLIP embedding?). search = stage 1 (query -> ranked Pixabay IDs, 24h TTL, only reached on an embedding miss). metadata = stage 2 (was this image ID already known from a different query?). file = stage 2 (was the compressed file already on disk?). A dropping line means that tier is doing less work for you.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": { "name": "grafanacloud-prom" },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "sum by (tier) (rate(imright_image_cache_lookups_total{result=\"hit\"}[$__rate_interval])) / sum by (tier) (rate(imright_image_cache_lookups_total[$__rate_interval]))",
                        "instant": false,
                        "range": true,
                        "legendFormat": "{{tier}}"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "version": "13.3.0-34259522365",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "unit": "percentunit",
                  "min": 0,
                  "max": 1,
                  "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" }
                },
                "overrides": []
              },
              "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Hits vs misses by tier (selected range)",
          "description": "Absolute counts, not rate - a 0% hit rate on 2 lookups is noise, on 200,000 it's a real problem.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": { "name": "grafanacloud-prom" },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "sum by (tier, result) (increase(imright_image_cache_lookups_total[$__range]))",
                        "instant": true,
                        "range": false,
                        "legendFormat": "{{tier}} / {{result}}"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "group": "bargauge",
            "kind": "VizConfig",
            "version": "13.3.0-34259522365",
            "spec": {
              "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
              "options": {
                "displayMode": "gradient",
                "orientation": "horizontal",
                "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
              }
            }
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Query dedup ratio",
          "description": "Cached queries per distinct image actually served. 1.0 = every query maps to a different image. Higher = more phrasings converging on the same images - the whole point of the ID-level cache.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": { "name": "grafanacloud-prom" },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "imright_image_cache_search_cache_queries / imright_image_cache_search_cache_distinct_images",
                        "instant": true,
                        "range": false,
                        "legendFormat": "dedup ratio"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "version": "13.3.0-34259522365",
            "spec": {
              "fieldConfig": { "defaults": { "unit": "short", "decimals": 2 }, "overrides": [] },
              "options": {
                "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
                "textMode": "auto",
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto"
              }
            }
          }
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "L1: cached queries (source) vs distinct images referenced (destination)",
          "description": "Source growing faster than destination is the dedup working as intended - many query phrasings landing on a smaller set of actual images. It's not a leak.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": { "name": "grafanacloud-prom" },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "imright_image_cache_search_cache_queries",
                        "instant": false,
                        "range": true,
                        "legendFormat": "source: cached queries"
                      }
                    }
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "B",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": { "name": "grafanacloud-prom" },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "imright_image_cache_search_cache_distinct_images",
                        "instant": false,
                        "range": true,
                        "legendFormat": "destination: distinct images"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "version": "13.3.0-34259522365",
            "spec": {
              "fieldConfig": {
                "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 5, "lineWidth": 1, "showPoints": "never" } },
                "overrides": []
              },
              "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
            }
          }
        }
      },
      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "L2: distinct Pixabay images with metadata cached",
          "description": "One row per Pixabay image ID ever seen in a search response - populated free from every hit, not just the one selected. Can run well ahead of the L3 downloaded-file count below.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": { "name": "grafanacloud-prom" },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "imright_image_cache_metadata_images",
                        "instant": false,
                        "range": true,
                        "legendFormat": "metadata rows"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "version": "13.3.0-34259522365",
            "spec": {
              "fieldConfig": {
                "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" } },
                "overrides": []
              },
              "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } }
            }
          }
        }
      },
      "panel-6": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "L3: downloaded images (count)",
          "description": "Distinct images actually downloaded + compressed to disk - the subset of L2 that was actually selected and used.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": { "name": "grafanacloud-prom" },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "imright_image_cache_downloaded_images",
                        "instant": false,
                        "range": true,
                        "legendFormat": "downloaded images"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "version": "13.3.0-34259522365",
            "spec": {
              "fieldConfig": {
                "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" } },
                "overrides": []
              },
              "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } }
            }
          }
        }
      },
      "panel-7": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "L3: downloaded bytes on disk (Railway volume usage)",
          "description": "Sum of compressed WebP file sizes on disk. This, plus the SQLite file size, is what determines how big your Railway volume needs to be. Red threshold line matches image-cache.js's IMAGE_CACHE_SIZE_WARNING_BYTES default (2GB, env-tunable) — a warn-level log fires at that point too (search Loki for \"image cache size exceeds warning threshold\"), checked at most once per 6h maintenance sweep, not per request.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": { "name": "grafanacloud-prom" },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "imright_image_cache_downloaded_bytes",
                        "instant": false,
                        "range": true,
                        "legendFormat": "bytes on disk"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "version": "13.3.0-34259522365",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "unit": "bytes",
                  "custom": {
                    "drawStyle": "line",
                    "fillOpacity": 10,
                    "lineWidth": 1,
                    "showPoints": "never",
                    "thresholdsStyle": { "mode": "line" }
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      { "value": null, "color": "green" },
                      { "value": 2147483648, "color": "red" }
                    ]
                  }
                },
                "overrides": []
              },
              "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } }
            }
          }
        }
      },
      "panel-8": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "Avg compressed size / image",
          "description": "downloaded_bytes / downloaded_images. A rising trend means bigger source photos or compression settings drifting looser than intended - check the sharp() resize/quality settings in utils/image-cache.js if this creeps up.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": { "name": "grafanacloud-prom" },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "imright_image_cache_downloaded_bytes / imright_image_cache_downloaded_images",
                        "instant": true,
                        "range": false,
                        "legendFormat": "avg bytes/image"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "version": "13.3.0-34259522365",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "unit": "bytes",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      { "value": null, "color": "green" },
                      { "value": 100000, "color": "orange" },
                      { "value": 300000, "color": "red" }
                    ]
                  }
                },
                "overrides": []
              },
              "options": {
                "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
                "textMode": "auto",
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto"
              }
            }
          }
        }
      },
      "panel-9": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "SQLite cache DB file size",
          "description": "search_cache + images metadata, no image bytes. Should stay tiny (KB-MB) indefinitely; if it grows unbounded, the 90-day disk-hygiene sweep in utils/image-cache.js may not be running (check it's a long-lived process, not a fresh CLI invocation every time).",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": { "name": "grafanacloud-prom" },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "imright_image_cache_db_file_bytes",
                        "instant": true,
                        "range": false,
                        "legendFormat": "db file bytes"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "version": "13.3.0-34259522365",
            "spec": {
              "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
              "options": {
                "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
                "textMode": "auto",
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto"
              }
            }
          }
        }
      },
      "panel-10": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "Real Pixabay API calls/sec, by operation (cross-check)",
          "description": "Existing general external-call metric (utils/external-api.js), not new to this dashboard - included because it's the ground truth for whether the cache is protecting you from Pixabay's rate limit. search = a real L1 miss, download = a real L3 miss.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": { "name": "grafanacloud-prom" },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "sum by (operation) (rate(imright_external_calls_total{service=\"pixabay\"}[$__rate_interval]))",
                        "instant": false,
                        "range": true,
                        "legendFormat": "{{operation}}"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "version": "13.3.0-34259522365",
            "spec": {
              "fieldConfig": {
                "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" } },
                "overrides": []
              },
              "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
            }
          }
        }
      },
      "panel-11": {
        "kind": "Panel",
        "spec": {
          "id": 11,
          "title": "Pixabay 429s (rate-limited)",
          "description": "Should be at or near zero if the cache is doing its job. Any sustained nonzero rate means real users are hitting misses faster than Pixabay's 100 req/60s allows.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": { "name": "grafanacloud-prom" },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "sum(rate(imright_external_rate_limited_total{service=\"pixabay\"}[$__rate_interval]))",
                        "instant": false,
                        "range": true,
                        "legendFormat": "429s/sec"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "version": "13.3.0-34259522365",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "unit": "reqps",
                  "min": 0,
                  "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 1, "showPoints": "never" },
                  "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "green" }, { "value": 0.01, "color": "red" }] }
                },
                "overrides": []
              },
              "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } }
            }
          }
        }
      },
      "panel-12": {
        "kind": "Panel",
        "spec": {
          "id": 12,
          "title": "Stage 0: embedded images vs downloaded images",
          "description": "downloaded_images (L3, from panel 6) vs embedded_images (distinct images with a stored CLIP embedding, the actual search-index size). embedded should briefly lag downloaded and then catch up — embeddings are computed after page-ready, not before (see the runPipeline hook in imright/index.js) — not lag forever.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": { "name": "grafanacloud-prom" },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "imright_image_cache_downloaded_images",
                        "instant": false,
                        "range": true,
                        "legendFormat": "downloaded (L3)"
                      }
                    }
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "B",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": { "name": "grafanacloud-prom" },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "imright_image_cache_embedded_images",
                        "instant": false,
                        "range": true,
                        "legendFormat": "embedded (stage 0 index)"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "version": "13.3.0-34259522365",
            "spec": {
              "fieldConfig": {
                "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 5, "lineWidth": 1, "showPoints": "never" } },
                "overrides": []
              },
              "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
            }
          }
        }
      },
      "panel-13": {
        "kind": "Panel",
        "spec": {
          "id": 13,
          "title": "Embedding-index similarity score by rank (p50)",
          "description": "Median cosine similarity of the top 3 candidates on every embedding search. The similarity-match threshold (EMBEDDING_SIMILARITY_THRESHOLD, currently 0.28, env-tunable, NOT empirically verified) decides hit vs miss on rank 1 only. If rank-1 sits just under the threshold a lot, the threshold is probably too strict; if rank-2/3 track rank-1 closely, the corpus may have a lot of near-duplicate matches for common queries.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": { "name": "grafanacloud-prom" },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "histogram_quantile(0.5, sum by (le, rank) (rate(imright_image_cache_embedding_similarity_bucket[$__rate_interval])))",
                        "instant": false,
                        "range": true,
                        "legendFormat": "rank {{rank}}"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
