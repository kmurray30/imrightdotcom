      "panel-8": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "HTTP requests by traffic class",
          "description": "page = real browser traffic, api_run = normal /api/run calls, scanner_probe = harmless bot noise, known_crawler = Googlebot etc, suspicious_api = /api/run that tripped abuse heuristics, blocked = login lockout.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "grafanacloud-prom"
                      },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "sum by (traffic_class) (rate(imright_http_requests_total[$__rate_interval]))",
                        "instant": false,
                        "range": true,
                        "legendFormat": "{{traffic_class}}"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "version": "13.3.0-34259522365",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "unit": "reqps",
                  "custom": {
                    "drawStyle": "line",
                    "fillOpacity": 20,
                    "stacking": {
                      "mode": "normal",
                      "group": "A"
                    },
                    "lineWidth": 1,
                    "showPoints": "never"
                  }
                },
                "overrides": []
              },
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "calcs": [
                    "mean",
                    "max"
                  ]
                },
                "tooltip": {
                  "mode": "multi"
                }
              }
            }
          }
        }
      },
