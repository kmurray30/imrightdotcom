                      "version": "v0",
                      "datasource": {
                        "name": "grafanacloud-prom"
                      },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "sum(increase(imright_visitors_total{type=\"new\"}[$__range]))",
                        "instant": true,
                        "range": false,
                        "legendFormat": ""
