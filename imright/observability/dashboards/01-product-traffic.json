      "panel-13": {
        "kind": "Panel",
        "spec": {
          "id": 13,
          "title": "Top visitors by interaction count (selected range)",
          "description": "Loki metric query over interaction_summary logs — needs visitor_id extracted via `| json`. See the bookmarked-queries doc if this shows no data.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "grafanacloud-logs"
                      },
                      "spec": {
                        "expr": "topk(15, sum by (visitor_id) (count_over_time({service_name=\"imright\"} |= `interaction_summary` | json [$__range])))",
                        "queryType": "instant",
                        "resultFormat": "table"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
