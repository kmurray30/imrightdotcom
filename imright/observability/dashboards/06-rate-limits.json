      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "LLM (XAI) rate-limited attempts",
          "description": "Count of LLM call attempts that got a 429 from XAI (selected range). XAI has its own retry loop, not the shared external-api wrapper, so this comes from imright_llm_calls_total's status label, not imright_external_rate_limited_total.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "grafanacloud-prom"
                      },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "sum(increase(imright_llm_calls_total{status=\"rate_limited\"}[$__range]))",
                        "instant": true,
                        "range": false,
                        "legendFormat": ""
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "version": "13.3.0-34259522365",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "decimals": 0,
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "red"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 1,
                        "color": "orange"
                      },
                      {
                        "value": 5,
                        "color": "red"
                      }
                    ]
                  }
                },
                "overrides": []
              },
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "textMode": "auto",
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto"
              }
            }
          }
        }
